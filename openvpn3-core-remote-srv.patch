+//
+
+#ifndef OPENVPN_CLIENT_SRVRESOLVE_H
+#define OPENVPN_CLIENT_SRVRESOLVE_H
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include <openvpn/io/io.hpp>
+#include <openvpn/asio/asiowork.hpp>
+#include <openvpn/common/bigmutex.hpp>
+#include <openvpn/common/platform.hpp>
+#include <openvpn/common/rc.hpp>
+#include <openvpn/common/string.hpp>
+#include <openvpn/transport/protocol.hpp>
+
+#ifdef OPENVPN_PLATFORM_WIN
+#include <windows.h>
+#include <windns.h>
+#include <openvpn/common/wstring.hpp>
+#else
+#include <resolv.h>
+#endif
+
+namespace openvpn::SRV {
+struct Record
+{
+    std::uint16_t priority = 0;
+    std::uint16_t weight = 0;
+    std::uint16_t port = 0;
+    std::string target;
+};
+
+struct Result
+{
+    std::vector<Record> records;
+    std::string error;
+};
+
+inline Protocol protocol_from_name(const std::string &name)
+{
+    const size_t first = name.find('.');
+    if (first == std::string::npos || first < 2 || name[0] != '_')
+        return Protocol();
+
+    const size_t second = name.find('.', first + 1);
+    if (second == std::string::npos || second + 1 >= name.size())
+        return Protocol();
+
+    const std::string proto = name.substr(first + 1, second - first - 1);
+    if (string::strcasecmp(proto, "_tcp") == 0)
+        return Protocol(Protocol::TCP);
+    if (string::strcasecmp(proto, "_udp") == 0)
+        return Protocol(Protocol::UDP);
+    return Protocol();
+}
+
+// Select one usable record from the lowest-priority group.  random_value is
+// supplied by the caller so the thread-unsafe client RNG stays on the I/O thread.
+inline bool select(const std::vector<Record> &records,
+                   const std::uint32_t random_value,
+                   Record &selected)
+{
+    std::vector<const Record *> candidates;
+    std::uint16_t min_priority = 0;
+    bool have_priority = false;
+
+    for (const auto &record : records)
+    {
+        if (record.target.empty() || record.target == "." || record.port == 0)
+            continue;
+        if (!have_priority || record.priority < min_priority)
+        {
+            min_priority = record.priority;
+            have_priority = true;
+        }
+    }
+    if (!have_priority)
+        return false;
+
+    std::uint32_t total_weight = 0;
+    for (const auto &record : records)
+    {
+        if (record.priority == min_priority
+            && !record.target.empty() && record.target != "." && record.port != 0)
+        {
+            candidates.push_back(&record);
+            total_weight += record.weight;
+        }
+    }
+
+    if (total_weight == 0)
+    {
+        selected = *candidates[random_value % candidates.size()];
+        return true;
+    }
+
+    std::uint32_t pick = random_value % total_weight;
+    for (const auto *record : candidates)
+    {
+        if (pick < record->weight)
+        {
+            selected = *record;
+            return true;
+        }
+        pick -= record->weight;
+    }
+    return false;
+}
+
+namespace detail {
+inline std::uint16_t read_u16(const unsigned char *p)
+{
+    return static_cast<std::uint16_t>((p[0] << 8) | p[1]);
+}
+
+inline const unsigned char *skip_name(const unsigned char *end,
+                                      const unsigned char *p)
+{
+    while (p < end)
+    {
+        const unsigned char c = *p;
+        if (c == 0)
+            return p + 1;
+        if ((c & 0xc0) == 0xc0)
+            return p + 2 <= end ? p + 2 : nullptr;
+        if ((c & 0xc0) != 0 || p + 1 + c > end)
+            return nullptr;
+        p += 1 + c;
+    }
+    return nullptr;
+}
+
+inline bool decode_name(const unsigned char *msg,
+                        const unsigned char *end,
+                        const unsigned char *p,
+                        std::string &out)
+{
+    unsigned int jumps = 0;
+    bool appended = false;
+
+    while (p < end)
+    {
+        const unsigned char c = *p;
+        if (c == 0)
+            return true;
+        if ((c & 0xc0) == 0xc0)
+        {
+            if (p + 2 > end || ++jumps > 32)
+                return false;
+            const size_t offset = ((c & 0x3f) << 8) | p[1];
+            if (msg + offset >= end)
+                return false;
+            p = msg + offset;
+            continue;
+        }
+        if ((c & 0xc0) != 0 || p + 1 + c > end)
+            return false;
+        if (out.size() + c + (appended ? 1 : 0) >= 256)
+            return false;
+        if (appended)
+            out += '.';
+        out.append(reinterpret_cast<const char *>(p + 1), c);
+        appended = true;
+        p += 1 + c;
+    }
+    return false;
+}
+
+inline void normalize_target(std::string &target)
+{
+    if (target.size() > 1 && target.back() == '.')
+        target.pop_back();
+}
+} // namespace detail
+
+// Parse a DNS response without depending on platform-specific nameser APIs.
+inline Result parse_response(const unsigned char *msg, const size_t len)
+{
+    Result result;
+    if (!msg || len < 12)
+    {
+        result.error = "short DNS response";
+        return result;
+    }
+    if ((msg[2] & 0x02) != 0)
+    {
+        result.error = "truncated DNS response";
+        return result;
+    }
+    if ((msg[3] & 0x0f) != 0)
+    {
+        result.error = "DNS server returned an error";
+        return result;
+    }
+
+    const unsigned char *p = msg + 12;
+    const unsigned char *end = msg + len;
+    const unsigned int qdcount = detail::read_u16(msg + 4);
+    const unsigned int ancount = detail::read_u16(msg + 6);
+
+    for (unsigned int i = 0; i < qdcount; ++i)
+    {
+        p = detail::skip_name(end, p);
+        if (!p || p + 4 > end)
+        {
+            result.error = "invalid DNS question section";
+            return result;
+        }
+        p += 4;
+    }
+
+    for (unsigned int i = 0; i < ancount; ++i)
+    {
+        p = detail::skip_name(end, p);
+        if (!p || p + 10 > end)
+        {
+            result.error = "invalid DNS answer section";
+            return result;
+        }
+
+        const std::uint16_t type = detail::read_u16(p);
+        const std::uint16_t dns_class = detail::read_u16(p + 2);
+        const std::uint16_t rdlength = detail::read_u16(p + 8);
+        const unsigned char *rdata = p + 10;
+        if (rdata + rdlength > end)
+        {
+            result.error = "invalid DNS record length";
+            return result;
+        }
+        p = rdata + rdlength;
+
+        if (type != 33 || dns_class != 1 || rdlength < 7)
+            continue;
+
+        Record record;
+        record.priority = detail::read_u16(rdata);
+        record.weight = detail::read_u16(rdata + 2);
+        record.port = detail::read_u16(rdata + 4);
+        if (!detail::decode_name(msg, end, rdata + 6, record.target))
+        {
+            result.error = "invalid SRV target name";
+            return result;
+        }
+        detail::normalize_target(record.target);
+        result.records.push_back(std::move(record));
+    }
+
+    if (result.records.empty())
+        result.error = "DNS response contains no SRV records";
+    return result;
+}
+
+inline Result query(const std::string &name)
+{
+    Result result;
+    if (!protocol_from_name(name).defined())
+    {
+        result.error = "SRV name must contain _tcp or _udp and a domain name";
+        return result;
+    }
+
+#ifdef OPENVPN_PLATFORM_WIN
+    try
+    {
+        const std::wstring wide_name = wstring::from_utf8(name);
+        PDNS_RECORD raw_records = nullptr;
+        const DNS_STATUS status = DnsQuery_W(wide_name.c_str(),
+                                             DNS_TYPE_SRV,
+                                             DNS_QUERY_STANDARD,
+                                             nullptr,
+                                             &raw_records,
+                                             nullptr);
+        if (status != ERROR_SUCCESS)
+        {
+            result.error = "DnsQuery_W failed with status " + std::to_string(status);
+            return result;
+        }
+
+        struct RecordGuard
+        {
+            PDNS_RECORD records;
+            ~RecordGuard()
+            {
+                if (records)
+                    DnsRecordListFree(records, DnsFreeRecordList);
+            }
+        } guard{raw_records};
+
+        // DnsQuery_W returns wide records even when PDNS_RECORD maps to the
+        // narrow structure in builds that do not define UNICODE.
+        for (PDNS_RECORDW current = reinterpret_cast<PDNS_RECORDW>(raw_records);
+             current;
+             current = current->pNext)
+        {
+            if (current->wType != DNS_TYPE_SRV)
+                continue;
+            Record record;
+            record.priority = current->Data.SRV.wPriority;
+            record.weight = current->Data.SRV.wWeight;
+            record.port = current->Data.SRV.wPort;
+            record.target = wstring::to_utf8(current->Data.SRV.pNameTarget);
+            detail::normalize_target(record.target);
+            result.records.push_back(std::move(record));
+        }
+        if (result.records.empty())
+            result.error = "DNS response contains no SRV records";
+    }
+    catch (const std::exception &e)
+    {
+        result.records.clear();
+        result.error = e.what();
+    }
+#else
+    unsigned char answer[4096];
+    const int len = res_query(name.c_str(), 1, 33, answer, sizeof(answer));
+    if (len < 0)
+    {
+        result.error = "res_query failed";
+        return result;
+    }
+    result = parse_response(answer, static_cast<size_t>(len));
+#endif
+    return result;
+}
+} // namespace openvpn::SRV
