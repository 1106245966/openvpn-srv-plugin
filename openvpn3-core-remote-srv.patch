+TEST(SRVResolve, SelectByPriorityAndWeight)
+{
+    const std::vector<SRV::Record> records{
+        {0, 100, 1, "."},
+        {5, 100, 0, "invalid-port.example.com"},
+        {10, 1, 443, "vpn1.example.com"},
+        {10, 3, 8443, "vpn2.example.com"},
+        {20, 100, 9443, "vpn3.example.com"},
+    };
+
+    SRV::Record selected;
+    ASSERT_TRUE(SRV::select(records, 0, selected));
+    ASSERT_EQ(selected.target, "vpn1.example.com");
+    ASSERT_TRUE(SRV::select(records, 1, selected));
+    ASSERT_EQ(selected.target, "vpn2.example.com");
+    ASSERT_EQ(selected.port, 8443);
+    ASSERT_TRUE(SRV::select(records, 3, selected));
+    ASSERT_EQ(selected.target, "vpn2.example.com");
+
+    const std::vector<SRV::Record> zero_weights{
+        {10, 0, 443, "vpn1.example.com"},
+        {10, 0, 8443, "vpn2.example.com"},
+    };
+    ASSERT_TRUE(SRV::select(zero_weights, 1, selected));
+    ASSERT_EQ(selected.target, "vpn2.example.com");
+
+    ASSERT_FALSE(SRV::select({}, 0, selected));
+    ASSERT_FALSE(SRV::select({{0, 0, 443, "."}}, 0, selected));
+}
