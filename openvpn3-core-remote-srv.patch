+TEST(SRVResolve, ParseCompressedResponse)
+{
+    const std::vector<unsigned char> response{
+        0x12, 0x34, 0x81, 0x80, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00,
+        0x08, '_', 'o', 'p', 'e', 'n', 'v', 'p', 'n',
+        0x04, '_', 'u', 'd', 'p',
+        0x07, 'e', 'x', 'a', 'm', 'p', 'l', 'e',
+        0x03, 'c', 'o', 'm', 0x00,
+        0x00, 0x21, 0x00, 0x01,
+        0xc0, 0x0c, 0x00, 0x21, 0x00, 0x01,
+        0x00, 0x00, 0x00, 0x3c, 0x00, 0x0d,
+        0x00, 0x0a, 0x00, 0x05, 0x04, 0xaa,
+        0x04, 'v', 'p', 'n', '1', 0xc0, 0x1a,
+    };
+
+    const SRV::Result result = SRV::parse_response(response.data(), response.size());
+    ASSERT_TRUE(result.error.empty()) << result.error;
+    ASSERT_EQ(result.records.size(), 1UL);
+    ASSERT_EQ(result.records[0].priority, 10);
+    ASSERT_EQ(result.records[0].weight, 5);
+    ASSERT_EQ(result.records[0].port, 1194);
+    ASSERT_EQ(result.records[0].target, "vpn1.example.com");
+}
