+namespace openvpn {
+// Detached synchronous system query with an I/O-thread completion callback.
+// Cancellation detaches the worker, matching AsyncResolvable's DNS semantics.
+class SRVResolvable
+{
+    class ResolveThread : public RC<thread_safe_refcount>
+    {
+        using Ptr = RCPtr<ResolveThread>;
+
+        openvpn_io::io_context &io_context;
+        SRVResolvable *parent;
+        std::atomic<bool> detached{false};
+
+        ResolveThread(openvpn_io::io_context &io_context_arg,
+                      SRVResolvable *parent_arg,
+                      const std::string &name)
+            : io_context(io_context_arg), parent(parent_arg)
+        {
+            std::thread thread([self = Ptr(this), name]()
+                               {
+                                   SRV::Result result;
+                                   try
+                                   {
+                                       result = SRV::query(name);
+                                   }
+                                   catch (const std::exception &e)
+                                   {
+                                       result.error = e.what();
+                                   }
+                                   catch (...)
+                                   {
+                                       result.error = "unknown SRV resolver error";
+                                   }
+                                   if (!self->is_detached())
+                                       self->post_callback(std::move(result)); });
+            thread.detach();
+        }
+
+        void detach()
+        {
+            detached.store(true, std::memory_order_relaxed);
+            parent = nullptr;
+        }
+
+        bool is_detached() const
+        {
+            return detached.load(std::memory_order_relaxed);
+        }
+
+        void post_callback(SRV::Result result)
+        {
+            openvpn_io::post(io_context,
+                             [self = Ptr(this), result = std::move(result)]() mutable
+                             {
+                                 SRVResolvable *parent = self->parent;
+                                 if (!self->is_detached() && parent)
+                                 {
+                                     self->detach();
+                                     OPENVPN_ASYNC_HANDLER;
+                                     parent->srv_resolve_callback(std::move(result));
+                                 }
+                             });
+        }
+
+        friend class SRVResolvable;
+    };
+
+    openvpn_io::io_context &io_context;
+    std::unique_ptr<AsioWork> asio_work;
+    RCPtr<ResolveThread> resolve_thread;
+
+  public:
+    explicit SRVResolvable(openvpn_io::io_context &io_context_arg)
+        : io_context(io_context_arg)
+    {
+    }
+
+    virtual ~SRVResolvable()
+    {
+        srv_resolve_cancel();
+    }
+
+    virtual void srv_resolve_callback(SRV::Result result) = 0;
+
+    virtual void async_resolve_srv(const std::string &name)
+    {
+        resolve_thread.reset(new ResolveThread(io_context, this, name));
+    }
+
+    void srv_resolve_lock()
+    {
+        asio_work.reset(new AsioWork(io_context));
+    }
+
+    void srv_resolve_cancel()
+    {
+        if (resolve_thread)
+        {
+            resolve_thread->detach();
+            resolve_thread.reset();
+        }
+        asio_work.reset();
+    }
+};
+} // namespace openvpn
