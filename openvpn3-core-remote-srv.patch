+TEST(RemoteList, SRVConfig)
+{
+    OptionList cfg;
+    cfg.parse_from_config(
+        "remote-random-hostname\n"
+        "remote plain.invalid 1111 udp\n"
+        "remote-srv _openvpn._tcp.vpn.example.com\n"
+        "<connection>\n"
+        "  proto udp6\n"
+        "  remote-srv _openvpn._udp.vpn.example.com\n"
+        "</connection>\n",
+        nullptr);
+    cfg.update_map();
+
+    const RandomAPI::Ptr rng(new FakeSecureRand(0xf7));
+    RemoteList rl(cfg, "", 0, nullptr, rng);
+    ASSERT_EQ(rl.size(), 3UL);
+    ASSERT_FALSE(rl.get_item(0)->is_srv());
+    ASSERT_EQ(rl.get_item(1)->srv_name, "_openvpn._tcp.vpn.example.com");
+    ASSERT_EQ(rl.get_item(1)->transport_protocol, Protocol(Protocol::TCPv4));
+    ASSERT_EQ(rl.get_item(1)->actual_host(), "_openvpn._tcp.vpn.example.com");
+    ASSERT_TRUE(rl.get_item(1)->random_host.empty());
+    ASSERT_EQ(rl.get_item(2)->srv_name, "_openvpn._udp.vpn.example.com");
+    ASSERT_EQ(rl.get_item(2)->transport_protocol, Protocol(Protocol::UDPv6));
+
+    rl.next();
+    SRV::Record record{10, 1, 4443, "vpn1.example.com"};
+    rl.current_item()->set_srv_target(record);
+    ASSERT_EQ(rl.current_server_host(), "vpn1.example.com");
+    ASSERT_EQ(rl.current_item()->actual_port(), "4443");
+    ASSERT_FALSE(rl.current_item()->need_srv_resolve());
+    rl.reset_current_srv();
+    ASSERT_TRUE(rl.current_item()->need_srv_resolve());
+    ASSERT_EQ(rl.current_server_host(), "_openvpn._tcp.vpn.example.com");
+}
