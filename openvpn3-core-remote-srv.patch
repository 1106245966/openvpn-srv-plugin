+TEST(RemoteList, SRVBulkResolve)
+{
+    class FakeBulkResolveWithSRV
+        : public FakeAsyncResolvable<RemoteList::BulkResolve,
+                                     openvpn_io::io_context &,
+                                     const RemoteList::Ptr &,
+                                     const SessionStats::Ptr &>
+    {
+        using Base = FakeAsyncResolvable<RemoteList::BulkResolve,
+                                         openvpn_io::io_context &,
+                                         const RemoteList::Ptr &,
+                                         const SessionStats::Ptr &>;
+
+      public:
+        using Base::Base;
+
+        void async_resolve_srv(const std::string &name) override
+        {
+            SRV::Result result;
+            result.error = "no fake SRV result";
+            const auto it = srv_results.find(name);
+            if (it != srv_results.end())
+                result = it->second;
+            this->srv_resolve_callback(std::move(result));
+        }
+
+        std::map<std::string, SRV::Result> srv_results;
+    };
+
+    OptionList cfg;
+    cfg.parse_from_config(
+        "remote-random-hostname\n"
+        "remote-cache-lifetime 60\n"
+        "remote-srv _openvpn._udp.vpn.example.com\n",
+        nullptr);
+    cfg.update_map();
+
+    const RandomAPI::Ptr rng(new FakeSecureRand(0xf7));
+    const RemoteList::Ptr rl(new RemoteList(cfg, "", 0, nullptr, rng));
+    rl->set_enable_cache(true);
+
+    openvpn_io::io_context ioctx;
+    const SessionStats::Ptr stats(new SessionStats());
+    FakeBulkResolveWithSRV fake_bulkres(ioctx, rl, stats);
+    SRV::Result srv_result;
+    srv_result.records.push_back({10, 0, 8443, "vpn1.example.com"});
+    fake_bulkres.srv_results["_openvpn._udp.vpn.example.com"] = srv_result;
+    fake_bulkres.set_results("vpn1.example.com", "8443", {{"192.0.2.1", 8443}});
+
+    BulkResolveNotifyIgn notify;
+    fake_bulkres.start(&notify);
+
+    const auto item = rl->current_item();
+    ASSERT_EQ(item->actual_host(), "vpn1.example.com");
+    ASSERT_EQ(item->actual_port(), "8443");
+    ASSERT_TRUE(item->random_host.empty());
+    ASSERT_TRUE(item->res_addr_list_defined());
+    const auto endpoint = fake_bulkres.init_endpoint();
+    auto mutable_endpoint = endpoint;
+    rl->get_endpoint(mutable_endpoint);
+    ASSERT_EQ(mutable_endpoint.address().to_string(), "192.0.2.1");
+    ASSERT_EQ(mutable_endpoint.port(), 8443);
+
+    rl->reset_current_srv();
+    ASSERT_FALSE(item->need_srv_resolve());
+    rl->reset_cache();
+    ASSERT_TRUE(item->need_srv_resolve());
+}
