+    /**
+     * 扫描应用私有目录，返回磁盘上实际存在的 profile 文件名（去掉 .cp/.cpold/.vp 后缀）。
+     */
+    private static Set<String> getProfileFilesFromDisk(Context context) {
+        Set<String> entries = new HashSet<>();
+        String[] suffixes = {".cp", ".cpold", ".vp"};
+        File[] files = context.getFilesDir().listFiles();
+        if (files == null) {
+            return entries;
+        }
+        for (File file : files) {
+            String name = file.getName();
+            for (String suffix : suffixes) {
+                if (name.endsWith(suffix)) {
+                    entries.add(name.substring(0, name.length() - suffix.length()));
+                    break;
+                }
+            }
+        }
+        return entries;
+    }
