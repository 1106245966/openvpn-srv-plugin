diff --git a/main/src/main/cpp/openvpn/src/openvpn/srv.c b/main/src/main/cpp/openvpn/src/openvpn/srv.c
new file mode 100644
index 0000000..cf16a57
--- /dev/null
+++ b/main/src/main/cpp/openvpn/src/openvpn/srv.c
@@ -0,0 +1,426 @@
+/*
+ *  OpenVPN -- An application to securely tunnel IP networks
+ *             over a single TCP/UDP port, with support for SSL/TLS-based
+ *             session authentication and key exchange,
+ *             packet encryption, packet authentication, and
+ *             packet compression.
+ *
+ *  Copyright (C) 2002-2026 OpenVPN Inc <sales@openvpn.net>
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2
+ *  as published by the Free Software Foundation.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "syshead.h"
+
+#include "srv.h"
+#include "error.h"
+#include "socket_util.h"
+#include "crypto.h"
+
+#include "memdbg.h"
+
+/* DNS 记录类型常量（避免依赖平台差异的 nameser.h 定义） */
+#define DNS_TYPE_SRV_VALUE 33
+#define DNS_CLASS_IN_VALUE 1
+
+/* 单次查询最多解析的 SRV 记录条数 */
+#define MAX_SRV_RECORDS 16
+
+/* 解析出的一条 SRV 记录 */
+struct srv_record
+{
+    uint16_t priority;
+    uint16_t weight;
+    uint16_t port;
+    char target[256];
+};
+
+/**
+ * 从 `_service._proto.name` 中提取协议，返回 PROTO_UDP 或 PROTO_TCP，
+ * 无法识别时返回 -1。
+ */
+static int
+srv_proto_from_name(const char *srv_name)
+{
+    const char *p1 = strchr(srv_name, '.');
+    if (!p1)
+    {
+        return -1;
+    }
+    const char *p2 = strchr(p1 + 1, '.');
+    if (!p2)
+    {
+        return -1;
+    }
+
+    size_t len = (size_t)(p2 - (p1 + 1));
+    if (len == 4 && strncmp(p1 + 1, "_tcp", 4) == 0)
+    {
+        return PROTO_TCP;
+    }
+    if (len == 4 && strncmp(p1 + 1, "_udp", 4) == 0)
+    {
+        return PROTO_UDP;
+    }
+    return -1;
+}
+
+/**
+ * 按 RFC 2782 的 priority/weight 规则，从候选记录中选出一条。
+ * 返回选中记录的下标，无记录时返回 -1。
+ */
+static int
+select_srv_record(const struct srv_record *records, int count)
+{
+    if (count <= 0)
+    {
+        return -1;
+    }
+
+    /* 找出最低 priority */
+    uint16_t min_priority = records[0].priority;
+    for (int i = 1; i < count; ++i)
+    {
+        if (records[i].priority < min_priority)
+        {
+            min_priority = records[i].priority;
+        }
+    }
+
+    /* 收集最低优先级组 */
+    int index[MAX_SRV_RECORDS];
+    int n = 0;
+    for (int i = 0; i < count; ++i)
+    {
+        if (records[i].priority == min_priority)
+        {
+            index[n++] = i;
+        }
+    }
+
+    /* 计算权重和，权重全零时退化为等概率 */
+    int total_weight = 0;
+    for (int i = 0; i < n; ++i)
+    {
+        total_weight += records[index[i]].weight;
+    }
+    if (total_weight == 0)
+    {
+        return index[(int)(get_random() % n)];
+    }
+
+    /* 加权随机选择 */
+    int pick = (int)(get_random() % total_weight);
+    int acc = 0;
+    for (int i = 0; i < n; ++i)
+    {
+        acc += records[index[i]].weight;
+        if (pick < acc)
+        {
+            return index[i];
+        }
+    }
+    return index[n - 1];
+}
+
+#if defined(_WIN32)
+
+#include <windows.h>
+#include <windns.h>
+
+/**
+ * Windows 实现：使用 DnsQuery_W 查询 SRV 记录。
+ */
+bool
+openvpn_resolve_srv(const char *srv_name, int *proto_out, struct gc_arena *gc,
+                    const char **host_out, const char **port_out)
+{
+    int proto = srv_proto_from_name(srv_name);
+    if (proto < 0)
+    {
+        msg(M_WARN, "remote-srv: bad SRV name (expected _service._tcp._name): %s", srv_name);
+        return false;
+    }
+
+    /* 将 UTF-8 查询名转为宽字符 */
+    int wlen = MultiByteToWideChar(CP_UTF8, 0, srv_name, -1, NULL, 0);
+    if (wlen <= 0)
+    {
+        return false;
+    }
+    wchar_t *wqname = gc_malloc((size_t)wlen * sizeof(wchar_t), false, gc);
+    MultiByteToWideChar(CP_UTF8, 0, srv_name, -1, wqname, wlen);
+
+    PDNS_RECORD result = NULL;
+    DNS_STATUS status = DnsQuery_W(wqname, DNS_TYPE_SRV, DNS_QUERY_STANDARD,
+                                   NULL, &result, NULL);
+    if (status != 0 || !result)
+    {
+        msg(M_WARN, "remote-srv: DnsQuery failed for %s (status %ld)", srv_name, (long)status);
+        return false;
+    }
+
+    /* 收集 SRV 记录 */
+    struct srv_record records[MAX_SRV_RECORDS];
+    int count = 0;
+    for (PDNS_RECORD r = result; r; r = r->pNext)
+    {
+        if (r->wType != DNS_TYPE_SRV || count >= MAX_SRV_RECORDS)
+        {
+            continue;
+        }
+        DNS_SRV_DATA *srv = &r->Data.SRV;
+        records[count].priority = srv->wPriority;
+        records[count].weight = srv->wWeight;
+        records[count].port = srv->wPort;
+        int alen = WideCharToMultiByte(CP_UTF8, 0, srv->pNameTarget, -1,
+                                       records[count].target, sizeof(records[count].target),
+                                       NULL, NULL);
+        if (alen <= 0)
+        {
+            continue;
+        }
+        count++;
+    }
+    DnsRecordListFree(result, DnsFreeRecordList);
+
+    int sel = select_srv_record(records, count);
+    if (sel < 0)
+    {
+        msg(M_WARN, "remote-srv: no SRV records found for %s", srv_name);
+        return false;
+    }
+
+    *proto_out = proto;
+    *host_out = string_alloc(records[sel].target, gc);
+    struct buffer port_buf = alloc_buf_gc(16, gc);
+    buf_printf(&port_buf, "%u", records[sel].port);
+    *port_out = BSTR(&port_buf);
+    return true;
+}
+
+#elif defined(HAVE_RESOLV_H)
+
+/**
+ * 读取 DNS 报文中的 16 位大端无符号整数。
+ */
+static uint16_t
+dns_read_u16(const unsigned char *p)
+{
+    return (uint16_t)((p[0] << 8) | p[1]);
+}
+
+/**
+ * 跳过 DNS 报文中的域名（处理压缩指针），返回域名之后的指针，失败返回 NULL。
+ */
+static const unsigned char *
+dns_skip_name(const unsigned char *msg, const unsigned char *end, const unsigned char *p)
+{
+    while (p < end)
+    {
+        unsigned char c = *p;
+        if (c == 0)
+        {
+            return p + 1;
+        }
+        if ((c & 0xC0) == 0xC0)
+        {
+            if (p + 1 >= end)
+            {
+                return NULL;
+            }
+            return p + 2;
+        }
+        p += 1 + c;
+    }
+    return NULL;
+}
+
+/**
+ * 解析 DNS 报文中的压缩域名，写入 out 缓冲区，返回长度，失败返回 -1。
+ */
+static int
+dns_decode_name(const unsigned char *msg, const unsigned char *end, const unsigned char *p,
+                char *out, size_t outlen)
+{
+    size_t pos = 0;
+    const unsigned char *cur = p;
+    int jumps = 0;
+
+    while (1)
+    {
+        if (cur >= end)
+        {
+            return -1;
+        }
+        unsigned char c = *cur;
+        if (c == 0)
+        {
+            break;
+        }
+        if ((c & 0xC0) == 0xC0)
+        {
+            if (cur + 1 >= end)
+            {
+                return -1;
+            }
+            uint16_t offset = (uint16_t)(((c & 0x3F) << 8) | cur[1]);
+            if (msg + offset >= end)
+            {
+                return -1;
+            }
+            cur = msg + offset;
+            if (++jumps > 32)
+            {
+                return -1;
+            }
+            continue;
+        }
+        if (cur + 1 + c > end)
+        {
+            return -1;
+        }
+        if (pos > 0)
+        {
+            if (pos + 1 >= outlen)
+            {
+                return -1;
+            }
+            out[pos++] = '.';
+        }
+        if (pos + c >= outlen)
+        {
+            return -1;
+        }
+        memcpy(out + pos, cur + 1, c);
+        pos += c;
+        cur += 1 + c;
+    }
+    out[pos] = '\0';
+    return (int)pos;
+}
+
+/**
+ * 从 res_query 返回的原始 DNS 报文中解析 SRV 记录，返回解析条数。
+ */
+static int
+parse_srv_response(const unsigned char *msg, int len,
+                   struct srv_record *records, int max_records)
+{
+    if (len < 12)
+    {
+        return 0;
+    }
+    uint16_t qdcount = dns_read_u16(msg + 4);
+    uint16_t ancount = dns_read_u16(msg + 6);
+
+    const unsigned char *p = msg + 12;
+    const unsigned char *end = msg + len;
+
+    /* 跳过 question section */
+    for (int i = 0; i < qdcount; ++i)
+    {
+        p = dns_skip_name(msg, end, p);
+        if (!p || p + 4 > end)
+        {
+            return 0;
+        }
+        p += 4;
+    }
+
+    /* 遍历 answer section，提取 SRV 记录 */
+    int count = 0;
+    for (int i = 0; i < ancount; ++i)
+    {
+        p = dns_skip_name(msg, end, p);
+        if (!p || p + 10 > end)
+        {
+            return count;
+        }
+        uint16_t type = dns_read_u16(p);
+        uint16_t rdlength = dns_read_u16(p + 8);
+        const unsigned char *rdata = p + 10;
+        if (rdata + rdlength > end)
+        {
+            return count;
+        }
+        p = rdata + rdlength;
+
+        if (type == DNS_TYPE_SRV_VALUE && rdlength >= 7 && count < max_records)
+        {
+            records[count].priority = dns_read_u16(rdata);
+            records[count].weight = dns_read_u16(rdata + 2);
+            records[count].port = dns_read_u16(rdata + 4);
+            int nlen = dns_decode_name(msg, end, rdata + 6,
+                                       records[count].target, sizeof(records[count].target));
+            if (nlen <= 0)
+            {
+                continue;
+            }
+            count++;
+        }
+    }
+    return count;
+}
+
+/**
+ * POSIX 实现：使用 res_query 查询 SRV 记录并手动解析响应。
+ */
+bool
+openvpn_resolve_srv(const char *srv_name, int *proto_out, struct gc_arena *gc,
+                    const char **host_out, const char **port_out)
+{
+    int proto = srv_proto_from_name(srv_name);
+    if (proto < 0)
+    {
+        msg(M_WARN, "remote-srv: bad SRV name (expected _service._tcp._name): %s", srv_name);
+        return false;
+    }
+
+    unsigned char answer[2048];
+    int len = res_query(srv_name, DNS_CLASS_IN_VALUE, DNS_TYPE_SRV_VALUE, answer, sizeof(answer));
+    if (len < 0)
+    {
+        msg(M_WARN, "remote-srv: SRV query failed for %s", srv_name);
+        return false;
+    }
+
+    struct srv_record records[MAX_SRV_RECORDS];
+    int count = parse_srv_response(answer, len, records, MAX_SRV_RECORDS);
+
+    int sel = select_srv_record(records, count);
+    if (sel < 0)
+    {
+        msg(M_WARN, "remote-srv: no SRV records found for %s", srv_name);
+        return false;
+    }
+
+    *proto_out = proto;
+    *host_out = string_alloc(records[sel].target, gc);
+    struct buffer port_buf = alloc_buf_gc(16, gc);
+    buf_printf(&port_buf, "%u", records[sel].port);
+    *port_out = BSTR(&port_buf);
+    return true;
+}
+
+#else /* 平台不支持 SRV 查询（无 DnsQuery 也无 resolv.h） */
+
+bool
+openvpn_resolve_srv(const char *srv_name, int *proto_out, struct gc_arena *gc,
+                    const char **host_out, const char **port_out)
+{
+    (void)srv_name;
+    (void)proto_out;
+    (void)gc;
+    (void)host_out;
+    (void)port_out;
+    return false;
+}
+
+#endif /* _WIN32 / HAVE_RESOLV_H */

