+ * @param host_out  输出目标主机名（gc 分配，调用方不可释放）
+ * @param port_out  输出目标端口字符串（gc 分配）
+ * @return          成功返回 true，失败返回 false
+ */
+bool openvpn_resolve_srv(const char *srv_name, int *proto_out, struct gc_arena *gc,
+                         const char **host_out, const char **port_out);
+
+#endif /* SRV_H */

