diff --git a/main/src/main/java/de/blinkt/openvpn/core/SrvResolver.java b/main/src/main/java/de/blinkt/openvpn/core/SrvResolver.java
new file mode 100644
index 0000000..a163ac4
--- /dev/null
+++ b/main/src/main/java/de/blinkt/openvpn/core/SrvResolver.java
@@ -0,0 +1,270 @@
+package de.blinkt.openvpn.core;
+
+import android.content.Context;
+import android.net.ConnectivityManager;
+import android.net.LinkProperties;
+import android.net.Network;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.net.DatagramPacket;
+import java.net.DatagramSocket;
+import java.net.InetAddress;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Random;
+
+/**
+ * Android 端 SRV 记录解析。
+ * Bionic 的 res_query() 依赖已废弃的 net.dns1 属性，在现代 Android 上不可用，
+ * 因此直接从系统当前网络的 DNS 服务器发 UDP 查询。
+ */
+public class SrvResolver {
+
+    private static final int TYPE_SRV = 33;
+
+    private static class Record {
+        int priority;
+        int weight;
+        int port;
+        String target;
+    }
+
+    /**
+     * 解析 _service._proto.name 形式的 SRV 名称。
+     *
+     * @return 长度为 3 的数组 {targetHost, port, "tcp"|"udp"}，失败返回 null
+     */
+    public static String[] resolve(Context context, String srvName) {
+        if (srvName == null) {
+            return null;
+        }
+        String proto = srvProto(srvName);
+        if (proto == null) {
+            return null;
+        }
+
+        try {
+            ConnectivityManager cm =
+                    (ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE);
+            Network network = cm != null ? cm.getActiveNetwork() : null;
+            if (network == null) {
+                return null;
+            }
+            LinkProperties lp = cm.getLinkProperties(network);
+            if (lp == null) {
+                return null;
+            }
+
+            for (InetAddress server : lp.getDnsServers()) {
+                try {
+                    byte[] answer = query(server, srvName);
+                    List<Record> records = parse(answer);
+                    Record picked = select(records);
+                    if (picked != null) {
+                        return new String[]{picked.target, Integer.toString(picked.port), proto};
+                    }
+                } catch (IOException ignored) {
+                    // 该 DNS 服务器不可达或未返回记录，尝试下一个
+                }
+            }
+        } catch (Exception e) {
+            return null;
+        }
+        return null;
+    }
+
+    private static String srvProto(String name) {
+        int first = name.indexOf('.');
+        if (first < 0) {
+            return null;
+        }
+        int second = name.indexOf('.', first + 1);
+        if (second < 0) {
+            return null;
+        }
+        String p = name.substring(first + 1, second);
+        if ("_tcp".equals(p)) {
+            return "tcp";
+        }
+        if ("_udp".equals(p)) {
+            return "udp";
+        }
+        return null;
+    }
+
+    private static byte[] encodeName(String name) throws IOException {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        for (String label : name.split("\\.")) {
+            byte[] raw = label.getBytes(StandardCharsets.US_ASCII);
+            if (raw.length == 0 || raw.length > 63) {
+                throw new IOException("bad label");
+            }
+            out.write(raw.length);
+            out.write(raw);
+        }
+        out.write(0);
+        return out.toByteArray();
+    }
+
+    private static byte[] query(InetAddress server, String name) throws IOException {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        int id = new Random().nextInt(0xFFFF);
+        out.write(id >> 8);
+        out.write(id & 0xFF);
+        out.write(0x01);            // RD
+        out.write(0x00);
+        out.write(0x00);            // QDCOUNT
+        out.write(0x01);
+        out.write(0x00);            // ANCOUNT
+        out.write(0x00);
+        out.write(0x00);            // NSCOUNT
+        out.write(0x00);
+        out.write(0x00);            // ARCOUNT
+        out.write(0x00);
+        out.write(encodeName(name));
+        out.write(0x00);            // QTYPE
+        out.write(TYPE_SRV);
+        out.write(0x00);            // QCLASS
+        out.write(0x01);
+        byte[] packet = out.toByteArray();
+
+        DatagramSocket socket = new DatagramSocket();
+        try {
+            socket.setSoTimeout(3000);
+            socket.send(new DatagramPacket(packet, packet.length, server, 53));
+            byte[] buf = new byte[4096];
+            DatagramPacket response = new DatagramPacket(buf, buf.length);
+            socket.receive(response);
+            return Arrays.copyOf(response.getData(), response.getLength());
+        } finally {
+            socket.close();
+        }
+    }
+
+    private static int u16(byte[] b, int off) {
+        return ((b[off] & 0xFF) << 8) | (b[off + 1] & 0xFF);
+    }
+
+    private static int skipName(byte[] msg, int p) {
+        int len = msg.length;
+        while (p < len) {
+            int c = msg[p] & 0xFF;
+            if (c == 0) {
+                return p + 1;
+            }
+            if ((c & 0xC0) == 0xC0) {
+                return p + 2;
+            }
+            p += 1 + c;
+        }
+        return -1;
+    }
+
+    private static String decodeName(byte[] msg, int p) {
+        StringBuilder sb = new StringBuilder();
+        int len = msg.length;
+        int jumps = 0;
+        while (p < len) {
+            int c = msg[p] & 0xFF;
+            if (c == 0) {
+                break;
+            }
+            if ((c & 0xC0) == 0xC0) {
+                if (p + 1 >= len) {
+                    return null;
+                }
+                int offset = ((c & 0x3F) << 8) | (msg[p + 1] & 0xFF);
+                if (offset >= len || ++jumps > 32) {
+                    return null;
+                }
+                p = offset;
+                continue;
+            }
+            if (p + 1 + c > len) {
+                return null;
+            }
+            if (sb.length() > 0) {
+                sb.append('.');
+            }
+            sb.append(new String(msg, p + 1, c, StandardCharsets.US_ASCII));
+            p += 1 + c;
+        }
+        return sb.length() == 0 ? null : sb.toString();
+    }
+
+    private static List<Record> parse(byte[] msg) {
+        List<Record> records = new ArrayList<>();
+        if (msg == null || msg.length < 12) {
+            return records;
+        }
+        int qdcount = u16(msg, 4);
+        int ancount = u16(msg, 6);
+        int p = 12;
+        for (int i = 0; i < qdcount; i++) {
+            p = skipName(msg, p);
+            if (p < 0 || p + 4 > msg.length) {
+                return records;
+            }
+            p += 4;
+        }
+        for (int i = 0; i < ancount; i++) {
+            p = skipName(msg, p);
+            if (p < 0 || p + 10 > msg.length) {
+                return records;
+            }
+            int type = u16(msg, p);
+            int rdlength = u16(msg, p + 8);
+            int rdata = p + 10;
+            if (rdata + rdlength > msg.length) {
+                return records;
+            }
+            p = rdata + rdlength;
+            if (type == TYPE_SRV && rdlength >= 7 && records.size() < 16) {
+                Record r = new Record();
+                r.priority = u16(msg, rdata);
+                r.weight = u16(msg, rdata + 2);
+                r.port = u16(msg, rdata + 4);
+                r.target = decodeName(msg, rdata + 6);
+                if (r.target != null) {
+                    records.add(r);
+                }
+            }
+        }
+        return records;
+    }
+
+    /** RFC 2782：最低 priority 组内按 weight 加权随机。 */
+    private static Record select(List<Record> records) {
+        if (records.isEmpty()) {
+            return null;
+        }
+        int minPriority = Integer.MAX_VALUE;
+        for (Record r : records) {
+            minPriority = Math.min(minPriority, r.priority);
+        }
+        List<Record> candidates = new ArrayList<>();
+        int total = 0;
+        for (Record r : records) {
+            if (r.priority == minPriority) {
+                candidates.add(r);
+                total += r.weight;
+            }
+        }
+        Random random = new Random();
+        if (total == 0) {
+            return candidates.get(random.nextInt(candidates.size()));
+        }
+        int pick = random.nextInt(total);
+        int acc = 0;
+        for (Record r : candidates) {
+            acc += r.weight;
+            if (pick < acc) {
+                return r;
+            }
+        }
+        return candidates.get(candidates.size() - 1);
+    }
+}
